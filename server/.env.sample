# https://docs.4gaboards.com/docs/dev/install/manual-vars

# Required
BASE_URL=http://localhost:1337
DATABASE_URL=postgresql://postgres@localhost/4gaBoards
SECRET_KEY=notsecretkey
DISCORD_TASK_WEBHOOK_URL=

# Add optional 4ga Boards instance variables here

# Google Calendar integration (optional)
# Encrypts OAuth refresh tokens at rest. Any passphrase works; changing it means every connected
# calendar account has to be re-authorized. Required for the integration to be available.
SECRET_ENCRYPTION_KEY=
# Defaults to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET when unset, so an instance already using
# Google SSO only needs to add BASE_URL/auth/google/calendar/callback as an authorized redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Do not edit this
TZ=UTC
